{
  "name": "sarradabet",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "npm run build:design-system && turbo run build",
    "build:design-system": "bash scripts/build-design-system.sh",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prisma:generate": "npm run -w apps/api prisma:generate",
    "prisma:migrate:dev": "npm run -w apps/api prisma:migrate:dev --",
    "prisma:migrate:deploy": "npm run -w apps/api prisma:migrate:deploy",
    "prisma:studio": "npm run -w apps/api prisma:studio",
    "prisma:check": "npm run -w apps/api prisma:check",
    "db:seed": "npm run -w apps/api db:seed",
    "db:seed:simple": "npm run -w apps/api db:seed:simple",
    "db:seed:test-bets": "npm run -w apps/api db:seed:test-bets",
    "db:reset": "npm run -w apps/api db:reset",
    "test": "turbo run test --filter=!e2e",
    "test:all": "turbo run test",
    "test:api": "npm run -w apps/api test",
    "test:api:watch": "npm run -w apps/api test:watch",
    "test:api:coverage": "npm run -w apps/api test:coverage",
    "test:api:unit": "npm run -w apps/api test:unit",
    "test:api:integration": "npm run -w apps/api test:integration",
    "test:web": "npm run -w apps/web test",
    "test:web:watch": "npm run -w apps/web test:watch",
    "test:web:coverage": "npm run -w apps/web test:coverage",
    "test:e2e": "npm run -w e2e test",
    "test:e2e:smoke": "npm run -w e2e test:smoke"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "overrides": {
    "on-headers": ">=1.1.0",
    "@eslint/plugin-kit": ">=0.3.4",
    "esbuild": ">=0.28.1",
    "body-parser": "^1.20.6",
    "postcss": "^8.5.26",
    "brace-expansion": "^5.0.9",
    "ip-address": "^10.4.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "socket.io-parser": "^4.2.7",
    "minimatch": "^10.2.1",
    "uuid": "11.1.1",
    "bull": {
      "uuid": "11.1.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^10.2.1"
    },
    "test-exclude": "^7.0.2",
    "@vitest/coverage-v8": {
      "test-exclude": "^7.0.2"
    }
  }
}
